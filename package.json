{
  "name": "scribe-extension",
  "displayName": "Playbook - 녹화로 끝나는 업무 매뉴얼",
  "version": "0.5.0",
  "description": "클릭 한 번 녹화로 끝나는 업무 매뉴얼. 클릭과 입력을 화면과 함께 기록하고, AI가 단계별 설명까지 써 드려요.",
  "author": "jingyung.lee",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "plasmo": "0.89.4",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.263",
    "@types/node": "^26.2.0",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "activeTab",
      "storage",
      "tabs",
      "unlimitedStorage",
      "cookies"
    ],
    "commands": {
      "toggle-recording": {
        "suggested_key": {
          "default": "Ctrl+Shift+E",
          "mac": "Command+Shift+E"
        },
        "description": "녹화 시작/종료 토글"
      }
    }
  }
}
